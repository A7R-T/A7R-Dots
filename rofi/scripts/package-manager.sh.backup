#!/bin/bash

# Package Management Menu
# Each function opens in its own floating kitty window with fzf interface

# Function to check if pacman is running
check_pacman_lock() {
    # Check if pacman database is locked
    if [ -f "/var/lib/pacman/db.lck" ]; then
        echo "❌ Package manager is already running!"
        echo "Please wait for the current operation to complete."
        echo ""
        echo "If you believe this is an error, you can remove the lock file with:"
        echo "  sudo rm /var/lib/pacman/db.lck"
        echo ""
        echo "⚠️ Only do this if you're certain no other pacman process is running!"
        return 1
    fi
    
    # Check for running pacman processes
    if pgrep -f "pacman|yay" >/dev/null; then
        echo "❌ Package manager processes are currently running!"
        echo ""
        echo "Running processes:"
        pgrep -fl "pacman|yay" | head -5
        echo ""
        echo "Please wait for these to complete before starting a new operation."
        return 1
    fi
    
    return 0
}

# Function to wait for pacman lock with timeout
wait_for_pacman() {
    local timeout=60
    local count=0
    
    while [ -f "/var/lib/pacman/db.lck" ] && [ $count -lt $timeout ]; do
        echo "⏳ Waiting for package manager to unlock... ($count/$timeout seconds)"
        sleep 2
        count=$((count + 2))
    done
    
    if [ -f "/var/lib/pacman/db.lck" ]; then
        echo ""
        echo "❌ Timeout waiting for package manager to unlock!"
        echo "You may need to manually remove the lock file:"
        echo "  sudo rm /var/lib/pacman/db.lck"
        return 1
    fi
    
    return 0
}

# Function to open floating kitty window
open_kitty_window() {
    local title="$1"
    local script_content="$2"
    
    # Create temporary script for kitty with lock functions included
    local temp_script="/tmp/package_operation_$$"
    cat > "$temp_script" << EOF
#!/bin/bash

# Function to check if pacman is running
check_pacman_lock() {
    # Check if pacman database is locked
    if [ -f "/var/lib/pacman/db.lck" ]; then
        echo "❌ Package manager is already running!"
        echo "Please wait for the current operation to complete."
        echo ""
        echo "If you believe this is an error, you can remove the lock file with:"
        echo "  sudo rm /var/lib/pacman/db.lck"
        echo ""
        echo "⚠️ Only do this if you're certain no other pacman process is running!"
        return 1
    fi
    
    # Check for running pacman processes
    if pgrep -f "pacman|yay" >/dev/null; then
        echo "❌ Package manager processes are currently running!"
        echo ""
        echo "Running processes:"
        pgrep -fl "pacman|yay" | head -5
        echo ""
        echo "Please wait for these to complete before starting a new operation."
        return 1
    fi
    
    return 0
}

# Function to wait for pacman lock with timeout
wait_for_pacman() {
    local timeout=60
    local count=0
    
    while [ -f "/var/lib/pacman/db.lck" ] && [ \$count -lt \$timeout ]; do
        echo "⏳ Waiting for package manager to unlock... (\$count/\$timeout seconds)"
        sleep 2
        count=\$((count + 2))
    done
    
    if [ -f "/var/lib/pacman/db.lck" ]; then
        echo ""
        echo "❌ Timeout waiting for package manager to unlock!"
        echo "You may need to manually remove the lock file:"
        echo "  sudo rm /var/lib/pacman/db.lck"
        return 1
    fi
    
    return 0
}

echo "╔════════════════════════════════════════════════════════════╗"
echo "║                     $title"
echo "╠════════════════════════════════════════════════════════════╣"
echo "║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# Check for package manager locks before starting
if ! check_pacman_lock; then
    echo ""
    echo "🔄 Attempt to wait for unlock? (y/N): "
    read -n 1 wait_choice
    echo ""
    
    if [[ "\$wait_choice" =~ ^[Yy]$ ]]; then
        if wait_for_pacman; then
            echo "✅ Package manager unlocked! Continuing..."
        else
            echo "❌ Cannot proceed. Please resolve the lock issue manually."
            echo ""
            echo "╔════════════════════════════════════════════════════════════╗"
            echo "║                     Operation Cancelled!"
            echo "║"
            echo "║  Press any key to exit..."
            echo "╚══════════════════════════════════════════════════════════════╝"
            read -n 1 -s
            exit 1
        fi
    else
        echo "❌ Operation cancelled by user."
        echo ""
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║                     Operation Cancelled!"
        echo "║"
        echo "║  Press any key to exit..."
        echo "╚══════════════════════════════════════════════════════════════╝"
        read -n 1 -s
        exit 1
    fi
fi

echo "✅ Package manager is ready!"
echo ""

$script_content

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                     Operation Complete!"
echo "║"
echo "║  Press any key to exit..."
echo "╚══════════════════════════════════════════════════════════════╝"
read -n 1 -s
EOF
    
    chmod +x "$temp_script"
    
    # Run in floating kitty window
    kitty --class package-manager --title="$title" --override window_padding.width=10 --override window_padding.height=10 --override initial_window_width=1000 --override initial_window_height=600 --override initial_window_mode=floating bash "$temp_script"
    
    # Clean up
    rm -f "$temp_script"
}

# Function to show package info
show_package_info() {
    local package="$1"
    if command -v yay >/dev/null 2>&1; then
        yay -Si "$package" | rofi -dmenu -i -p "Package Info: $package" -config ~/.config/rofi/config.rasi
    elif command -v pacman >/dev/null 2>&1; then
        pacman -Si "$package" 2>/dev/null | rofi -dmenu -i -p "Package Info: $package" -config ~/.config/rofi/config.rasi
    fi
}

# Function to install packages with fzf interface
install_packages() {
    local install_script='
echo "📦 Package Installation Interface"
echo "=================================="
echo ""

# Function to show package info
show_pkg_info() {
    if command -v yay >/dev/null 2>&1; then
        yay -Si "$1" | less
    elif command -v pacman >/dev/null 2>&1; then
        pacman -Si "$1" 2>/dev/null | less
    fi
}

# Main installation loop
while true; do
    echo "Select packages to install (Tab to multi-select, Enter to install, Esc to exit):"
    echo ""
    
    if command -v yay >/dev/null 2>&1; then
        echo "Using yay (includes AUR packages)..."
        PKGS=$(yay -Slq | fzf --multi --preview="yay -Si {1}" --preview-window=right:wrap --bind="enter:accept" --bind="esc:abort" --header="Tab: Multi-select | Enter: Install | Esc: Exit")
    elif command -v pacman >/dev/null 2>&1; then
        echo "Using pacman (official repos only)..."
        PKGS=$(pacman -Slq | fzf --multi --preview="pacman -Si {1}" --preview-window=right:wrap --bind="enter:accept" --bind="esc:abort" --header="Tab: Multi-select | Enter: Install | Esc: Exit")
    else
        echo "❌ No package manager found (yay or pacman required)"
        break
    fi
    
    if [ -z "$PKGS" ]; then
        echo "🚫 No packages selected or user cancelled"
        break
    fi
    
    echo ""
    echo "📋 Selected packages:"
    echo "$PKGS" | while read -r pkg; do
        echo "  • $pkg"
    done
    
    echo ""
    echo "🔍 View package info? (y/N/q): "
    read -n 1 info_choice
    echo ""
    
    if [[ "$info_choice" =~ ^[Yy]$ ]]; then
        echo "$PKGS" | while read -r pkg; do
            echo "📄 Info for $pkg:"
            show_pkg_info "$pkg"
            echo "--- Press Enter to continue ---"
            read
        done
        continue
    elif [[ "$info_choice" =~ ^[Qq]$ ]]; then
        echo "🚫 Cancelled"
        break
    fi
    
    echo ""
    echo "🚀 Install selected packages? (y/N/q): "
    read -n 1 install_choice
    echo ""
    
    if [[ "$install_choice" =~ ^[Yy]$ ]]; then
        echo ""
        echo "🔧 Installing packages..."
        echo ""
        
        # Final lock check before installation
        if check_pacman_lock; then
            if command -v yay >/dev/null 2>&1; then
                echo "\$PKGS" | xargs -I {} yay -S {}
            elif command -v pacman >/dev/null 2>&1; then
                echo "\$PKGS" | xargs -I {} sudo pacman -S {}
            fi
            
            echo ""
            echo "✅ Installation complete!"
        else
            echo ""
            echo "❌ Cannot install - package manager is locked!"
            echo "Please wait for other operations to complete."
        fi
        break
    elif [[ "$install_choice" =~ ^[Qq]$ ]]; then
        echo "🚫 Cancelled"
        break
    else
        echo "🔄 Selecting different packages..."
        echo ""
        continue
    fi
done
'
    
    open_kitty_window "Package Installation" "$install_script"
}

# Function to remove packages with fzf interface
remove_packages() {
    local remove_script='
echo "🗑️ Package Removal Interface"
echo "=============================="
echo ""

# Function to show package info
show_pkg_info() {
    if command -v pacman >/dev/null 2>&1; then
        pacman -Qi "$1" | less
    fi
}

# Main removal loop
while true; do
    echo "Select packages to remove (Tab to multi-select, Enter to remove, Esc to exit):"
    echo ""
    
    PKGS=$(pacman -Qq | fzf --multi --preview="pacman -Qi {1}" --preview-window=right:wrap --bind="enter:accept" --bind="esc:abort" --header="Tab: Multi-select | Enter: Remove | Esc: Exit")
    
    if [ -z "$PKGS" ]; then
        echo "🚫 No packages selected or user cancelled"
        break
    fi
    
    echo ""
    echo "📋 Selected packages to remove:"
    echo "$PKGS" | while read -r pkg; do
        echo "  • $pkg"
    done
    
    echo ""
    echo "🔍 View package info? (y/N/q): "
    read -n 1 info_choice
    echo ""
    
    if [[ "$info_choice" =~ ^[Yy]$ ]]; then
        echo "$PKGS" | while read -r pkg; do
            echo "📄 Info for $pkg:"
            show_pkg_info "$pkg"
            echo "--- Press Enter to continue ---"
            read
        done
        continue
    elif [[ "$info_choice" =~ ^[Qq]$ ]]; then
        echo "🚫 Cancelled"
        break
    fi
    
    echo ""
    echo "⚠️ Remove selected packages with dependencies? (y/N/q): "
    read -n 1 remove_choice
    echo ""
    
    if [[ "$remove_choice" =~ ^[Yy]$ ]]; then
        echo ""
        echo "🔧 Removing packages..."
        echo ""
        
        # Final lock check before removal
        if check_pacman_lock; then
            echo "\$PKGS" | xargs -I {} sudo pacman -Rsn {}
            echo ""
            echo "✅ Removal complete!"
        else
            echo ""
            echo "❌ Cannot remove - package manager is locked!"
            echo "Please wait for other operations to complete."
        fi
        break
    elif [[ "$remove_choice" =~ ^[Qq]$ ]]; then
        echo "🚫 Cancelled"
        break
    else
        echo "🔄 Selecting different packages..."
        echo ""
        continue
    fi
done
'
    
    open_kitty_window "Package Removal" "$remove_script"
}

# Function to search packages with fzf interface
search_packages() {
    local search_script='
echo "🔍 Package Search Interface"
echo "==========================="
echo ""

# Function to show package info
show_pkg_info() {
    if command -v yay >/dev/null 2>&1; then
        yay -Si "$1" | less
    elif command -v pacman >/dev/null 2>&1; then
        pacman -Si "$1" 2>/dev/null | less
    fi
}

# Function to install package
install_package() {
    local pkg="$1"
    echo ""
    echo "🚀 Installing $pkg..."
    echo ""
    
    if command -v yay >/dev/null 2>&1; then
        yay -S "$pkg"
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -S "$pkg"
    fi
    
    echo ""
    echo "✅ Installation complete!"
}

# Main search loop
while true; do
    echo "🔍 Enter search term (or Ctrl+C to exit):"
    read -p "Search: " query
    
    if [ -z "$query" ]; then
        echo "🚫 Empty search term"
        continue
    fi
    
    echo ""
    echo "🔎 Searching for: $query"
    echo ""
    
    if command -v yay >/dev/null 2>&1; then
        results=$(yay -Ss "$query" | fzf --preview="echo {} | sed \"s/^[^\\/]*\\/\\([^ ]*\\).*/\\1/\" | xargs -I {} yay -Si {}" --preview-window=right:wrap --bind="enter:accept" --bind="ctrl-i:abort" --header="Enter: Install | Ctrl+I: New Search | Esc: Exit" --header-first)
    elif command -v pacman >/dev/null 2>&1; then
        results=$(pacman -Ss "$query" | fzf --preview="echo {} | sed \"s/^[^\\/]*\\/\\([^ ]*\\).*/\\1/\" | xargs -I {} pacman -Si {}" --preview-window=right:wrap --bind="enter:accept" --bind="ctrl+i:abort" --header="Enter: Install | Ctrl+I: New Search | Esc: Exit" --header-first)
    fi
    
    if [ -z "$results" ]; then
        echo "🚫 No packages found or user cancelled"
        continue
    fi
    
    # Extract package name from result
    pkg=$(echo "$results" | sed "s/^[^\/]*\/\([^ ]*\).*/\1/")
    
    echo ""
    echo "📄 Package info for $pkg:"
    show_pkg_info "$pkg"
    
    echo ""
    echo "🚀 Install $pkg? (y/N/n): "
    read -n 1 install_choice
    echo ""
    
    if [[ "$install_choice" =~ ^[Yy]$ ]]; then
        # Final lock check before installation
        if check_pacman_lock; then
            install_package "$pkg"
        else
            echo ""
            echo "❌ Cannot install - package manager is locked!"
            echo "Please wait for other operations to complete."
        fi
        echo ""
        echo "🔄 Search for another package? (y/N): "
        read -n 1 continue_choice
        echo ""
        
        if [[ ! "$continue_choice" =~ ^[Yy]$ ]]; then
            break
        fi
    elif [[ "$install_choice" =~ ^[Nn]$ ]]; then
        echo "🔄 Try another search term? (y/N): "
        read -n 1 continue_choice
        echo ""
        
        if [[ ! "$continue_choice" =~ ^[Yy]$ ]]; then
            break
        fi
    fi
done
'
    
    open_kitty_window "Package Search" "$search_script"
}

# Function to upgrade system
upgrade_system() {
    local upgrade_script='
echo "🔄 System Upgrade Interface"
echo "=========================="
echo ""

echo "🔍 Checking for updates..."
echo ""

if command -v yay >/dev/null 2>&1; then
    echo "🚀 Using yay (includes AUR updates)..."
    echo ""
    
    echo "🚀 Starting system upgrade..."
    echo ""
    
    # Final lock check before upgrade
    if check_pacman_lock; then
        yay -Syu
    else
        echo ""
        echo "❌ Cannot upgrade - package manager is locked!"
        echo "Please wait for other operations to complete."
    fi
    
    echo ""
    echo "✅ System upgrade complete!"
    
    echo ""
    echo "🔍 Check for orphan packages? (y/N): "
    read -n 1 orphans_choice
    echo ""
    
    if [[ "$orphans_choice" =~ ^[Yy]$ ]]; then
        orphans=$(pacman -Qtdq)
        if [ -n "$orphans" ]; then
            echo "🧹 Removing orphan packages..."
            echo "$orphans" | xargs sudo pacman -Rns
            echo "✅ Orphans removed!"
        else
            echo "✨ No orphan packages found"
        fi
    fi
    
elif command -v pacman >/dev/null 2>&1; then
    echo "📦 Using pacman (official repos only)..."
    echo ""
    
    echo "🚀 Starting system upgrade..."
    echo ""
    
    # Final lock check before upgrade
    if check_pacman_lock; then
        sudo pacman -Syu
    else
        echo ""
        echo "❌ Cannot upgrade - package manager is locked!"
        echo "Please wait for other operations to complete."
    fi
    
    echo ""
    echo "✅ System upgrade complete!"
    
    echo ""
    echo "🔍 Check for orphan packages? (y/N): "
    read -n 1 orphans_choice
    echo ""
    
    if [[ "$orphans_choice" =~ ^[Yy]$ ]]; then
        orphans=$(pacman -Qtdq)
        if [ -n "$orphans" ]; then
            echo "🧹 Removing orphan packages..."
            echo "$orphans" | xargs sudo pacman -Rns
            echo "✅ Orphans removed!"
        else
            echo "✨ No orphan packages found"
        fi
    fi
    
else
    echo "❌ No package manager found (yay or pacman required)"
fi

echo ""
echo "🧹 Clean package cache? (y/N): "
read -n 1 cache_choice
echo ""

if [[ "$cache_choice" =~ ^[Yy]$ ]]; then
    # Lock check before cleaning cache
    if check_pacman_lock; then
        if command -v yay >/dev/null 2>&1; then
            echo "🧹 Cleaning cache with yay..."
            yay -Scc
        elif command -v pacman >/dev/null 2>&1; then
            echo "🧹 Cleaning cache with pacman..."
            sudo pacman -Scc
        fi
        echo "✅ Cache cleaned!"
    else
        echo ""
        echo "❌ Cannot clean cache - package manager is locked!"
        echo "Please wait for other operations to complete."
    fi
fi

echo ""
echo "🎉 All operations completed!"
'
    
    open_kitty_window "System Upgrade" "$upgrade_script"
}

# Function to list installed packages
list_installed() {
    if command -v yay >/dev/null 2>&1; then
        local PKG=$(yay -Qq | rofi -dmenu -i -p "Select installed package" -config ~/.config/rofi/config.rasi -mesg "Browse installed packages")
        if [ -n "$PKG" ]; then
            show_package_info "$PKG"
        fi
    elif command -v pacman >/dev/null 2>&1; then
        local PKG=$(pacman -Qq | rofi -dmenu -i -p "Select installed package" -config ~/.config/rofi/config.rasi -mesg "Browse installed packages")
        if [ -n "$PKG" ]; then
            show_package_info "$PKG"
        fi
    fi
}

# Function to list installed packages
list_installed() {
    local list_script='
echo "📋 Installed Packages Browser"
echo "============================"
echo ""

# Function to show package info
show_pkg_info() {
    if command -v pacman >/dev/null 2>&1; then
        pacman -Qi "$1" | less
    fi
}

# Main browse loop
while true; do
    echo "🔍 Select package to view info (Esc to exit):"
    echo ""
    
    PKG=$(pacman -Qq | fzf --preview="pacman -Qi {1}" --preview-window=right:wrap --bind="enter:accept" --bind="esc:abort" --header="Enter: View Info | Esc: Exit")
    
    if [ -z "$PKG" ]; then
        echo "🚫 No package selected or user cancelled"
        break
    fi
    
    echo ""
    echo "📄 Package info for $PKG:"
    show_pkg_info "$PKG"
    
    echo ""
    echo "🔄 Browse another package? (y/N): "
    read -n 1 continue_choice
    echo ""
    
    if [[ ! "$continue_choice" =~ ^[Yy]$ ]]; then
        break
    fi
done
'
    
    open_kitty_window "Installed Packages" "$list_script"
}

# Function to browse package files
browse_files() {
    local files_script='
echo "📁 Package File Browser"
echo "======================"
echo ""

# Main browse loop
while true; do
    echo "📦 Select package to browse files (Esc to exit):"
    echo ""
    
    PKG=$(pacman -Qq | fzf --preview="pacman -Qi {1}" --preview-window=right:wrap --bind="enter:accept" --bind="esc:abort" --header="Enter: Browse Files | Esc: Exit")
    
    if [ -z "$PKG" ]; then
        echo "🚫 No package selected or user cancelled"
        break
    fi
    
    echo ""
    echo "📄 Files in package $PKG:"
    echo ""
    
    files=$(pacman -Ql "$PKG" 2>/dev/null | tail -n +2 | awk "{print \$2}")
    if [ -n "$files" ]; then
        selected_file=$(echo "$files" | fzf --preview="test -f {} && head -20 {} || echo \"Directory or binary file\"" --preview-window=right:wrap --bind="enter:accept" --bind="esc:abort" --header="Enter: View File | Esc: Back to package list")
        
        if [ -n "$selected_file" ] && [ -f "$selected_file" ]; then
            echo ""
            echo "📄 Viewing file: $selected_file"
            echo ""
            
            if command -v nvim >/dev/null 2>&1; then
                nvim "$selected_file"
            else
                less "$selected_file"
            fi
            
            echo ""
            echo "🔄 Browse more files from $PKG? (y/N): "
            read -n 1 continue_files
            echo ""
            
            if [[ ! "$continue_files" =~ ^[Yy]$ ]]; then
                break
            fi
        fi
    fi
done
'
    
    open_kitty_window "Package Files Browser" "$files_script"
}

# Function to show package statistics
show_stats() {
    local stats_script='
echo "📊 Package Statistics"
echo "===================="
echo ""

if command -v pacman >/dev/null 2>&1; then
    total=$(pacman -Qq | wc -l)
    explicit=$(pacman -Qeq | wc -l)
    orphans=$(pacman -Qtdq | wc -l)
    size=$(pacman -Qi | awk "/^Installed Size/ {sum += \$4} END {print sum / 1024 / 1024}")
    
    echo "📦 Total Packages: $total"
    echo "🎯 Explicitly Installed: $explicit"
    echo "🧹 Orphan Packages: $orphans"
    echo "💾 Total Size: ${size} MB"
    echo ""
    
if [ "$orphans" -gt 0 ]; then
        echo "🧹 Removing orphan packages..."
        
        # Lock check before removing orphans
        if check_pacman_lock; then
            echo "\$orphans" | xargs sudo pacman -Rns
            echo "✅ Orphans removed!"
        else
            echo ""
            echo "❌ Cannot remove orphans - package manager is locked!"
            echo "Please wait for other operations to complete."
        fi
    else
        echo "✨ No orphan packages found"
    fi
    fi
    
    echo ""
    echo "📈 Top 10 largest packages:"
    pacman -Qi | awk "/^Installed Size/ {size += \$4} /^Name/ {name = \$3; getline; getline; if(size > 0) print name, size \"MB\"; size = 0}" | sort -k2 -nr | head -10 | while IFS= read -r line; do
        echo "  $line"
    done
else
    echo "❌ pacman not found"
fi
'
    
    open_kitty_window "Package Statistics" "$stats_script"
}

# Function to show package statistics
show_stats() {
    if command -v pacman >/dev/null 2>&1; then
        local total=$(pacman -Qq | wc -l)
        local explicit=$(pacman -Qeq | wc -l)
        local orphans=$(pacman -Qtdq | wc -l)
        local size=$(pacman -Qi | awk '/^Installed Size/ {sum += $4} END {print sum / 1024 / 1024}')
        
        local stats="Package Statistics:
Total Packages: $total
Explicitly Installed: $explicit
Orphan Packages: $orphans
Total Size: ${size} MB"
        
        rofi -e "$stats" -config ~/.config/rofi/config.rasi
    fi
}

# Function to browse package files
browse_files() {
    local PKG=$(pacman -Qq | rofi -dmenu -i -p "Select package" -config ~/.config/rofi/config.rasi -mesg "Browse package files")
    if [ -n "$PKG" ]; then
        local files=$(pacman -Ql "$PKG" 2>/dev/null | tail -n +2 | awk '{print $2}')
        if [ -n "$files" ]; then
            local selected=$(echo "$files" | rofi -dmenu -i -p "Select file to view" -config ~/.config/rofi/config.rasi -mesg "Files in $PKG")
            if [ -n "$selected" ] && [ -f "$selected" ]; then
                if command -v nvim >/dev/null 2>&1; then
                    nvim "$selected"
                else
                    xdg-open "$selected"
                fi
            fi
        fi
    fi
}

# Main menu
ACTIONS="󰏗 Install Packages\n󰆴 Remove Packages\n󰍉 Search Packages\n󰒔 Upgrade System\n󱓎 Installed Packages\n󰒺 Clean Cache\n󰅪 Check Orphans\n󰊕 Package Statistics\n󰈙 Browse Files"

CHOSEN=$(echo -e "$ACTIONS" | rofi -dmenu -i -p "Package Manager" -config ~/.config/rofi/config.rasi)

case "$CHOSEN" in
    "󰏗 Install Packages")
        install_packages
        ;;
    "󰆴 Remove Packages")
        remove_packages
        ;;
    "󰍉 Search Packages")
        search_packages
        ;;
    "󰒔 Upgrade System")
        upgrade_system
        ;;
    "󱓎 Installed Packages")
        list_installed
        ;;
