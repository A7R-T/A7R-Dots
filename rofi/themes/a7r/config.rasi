/*
 * Rofi configuration following a simplified, transparent Material design.
 * Base Color: #6DA6CE (Muted Cyan/Blue)
 * Font: Hurmit Nerd Font
 */

configuration {
    modi: "drun,run,ssh";
    show-icons: true;
    display-drun: "Apps";
    display-run: "Run";
    display-ssh: "SSH";
    sidebar-mode: false;
    font: "Hurmit Nerd Font 10";
}

/* Base Palette Definitions */
* {
    /* Base Color: Muted Cyan/Blue */
    accent-color:    #6DA6CE;

    /* Backgrounds: Darkened versions of the accent tone */
    bg-primary:      #0e151b73; /* Main box background, 99 for slight transparency */
    bg-secondary:    #161e2573; /* Input bar/alternate background, slightly lighter */
    
    /* Text Colors */
    fg-main:         #DCE9F2;   /* Main text color */
    fg-alt:          #9ebbc9;   /* Muted text color for context */

    /* Universal transparent setting */
    transparent:     #00000000;
}

/* --------------------------------------------------------------------------
 * Main Window: Fully transparent and centered.
 * -------------------------------------------------------------------------- */
window {
    background-color: @transparent;
    border: 0;
    padding: 0;
    width: 37%; /* Slightly wider window */
    location: center;
    anchor: center;
    border-radius: 17px; /* Slightly more pronounced rounding */
}

/* --------------------------------------------------------------------------
 * Main Box: The colored container that provides elevation/depth.
 * -------------------------------------------------------------------------- */
mainbox {
    background-color: @bg-primary;
    border: 1px solid;
    border-color: @fg-alt;
    padding: 27px; /* Increased internal padding */
    border-radius: 17px;
}

/* --------------------------------------------------------------------------
 * Input Bar: Clean, simple box for search.
 * -------------------------------------------------------------------------- */
inputbar {
    children: [ prompt, entry ];
    background-color: @bg-secondary;
    border: 1px solid;
    border-color: @fg-alt;
    padding: 12px;
    spacing: 15px;
    border-radius: 12px;
    margin: 0 0 15px 0; /* Space between input and list */
}

prompt {
    enabled: true;
    background-color: @transparent;
    text-color: @accent-color; /* Accent color on the prompt symbol */
}

entry {
    background-color: @transparent;
    text-color: @fg-main;
    placeholder-color: @fg-alt;
    placeholder: "Search applications or commands...";
}

/* --------------------------------------------------------------------------
 * List View
 * -------------------------------------------------------------------------- */
listview {
    background-color: @transparent;
    columns: 1;
    lines: 7;
    spacing: 7px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    fixed-height: false;
}

/* --------------------------------------------------------------------------
 * Elements (Individual rows)
 * -------------------------------------------------------------------------- */
element normal.normal {
  background-color: @transparent;
  text-color: @fg-alt;
}

element normal.urgent {
  background-color: @transparent;
  text-color: @fg-alt;
}

element normal.active {
  background-color: @transparent;
  text-color: @fg-alt;
}

element alternate.normal {
  background-color: @transparent;
  text-color: @fg-alt;
}

element {
    background-color: @transparent;
    text-color: @fg-alt;
    padding: 5px;
    border-radius: 7px;
    spacing: 7px;
}

element-icon {
    size: 1.3em;
    background-color: @transparent;
    text-color: inherit;
}

element-text {
    background-color: @transparent;
    text-color: inherit;
}

/* Highlighted (Selected) Element: Flat color background for focus */
element selected {
    background-color: @accent-color; /* Solid accent color */
    text-color: @bg-primary; /* Dark text for maximum contrast */
    border: 0;
}

element selected.normal {
    background-color: @fg-alt; /* Solid accent color */
    text-color: #0D263E; /* Dark text for maximum contrast */
    border: 0;
}

element selected element-text {
    text-color: @bg-primary;
}

element selected element-icon {
    text-color: @bg-primary;
}

scrollbar {
  width: 0;
  handle-width: 0;
  handle-color: transparent;
}
